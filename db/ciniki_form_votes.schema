#
# Description
# -----------
# This table stores the votes made by the jurors.
#
# Fields
# ------
# id:                       The ID assigned to the record.
# uuid:                     The Universal Unique ID.
# tnid:                     The Tenant ID the record belongs to.
#
# submission_id:            The ID of the submission the vote is for.
# juror_id:                 The ID of the juror for the form.
# vote:                     The vote placed by the juror.
#
#                               1 - No
#                               2 - Maybe
#                               3 - Yes
#
# date_added:               The UTC date and time the record was added.
# last_updated:             The UTC date and time the record was last update.
#
create table ciniki_form_votes (
    id int not null auto_increment,
    uuid char(36) not null,
    tnid int not null,

    submission_id int not null,
    juror_id int not null,
    vote int not null,
    notes text not null,

    date_added datetime not null,
    last_updated datetime not null,
    primary key (id),
    unique index (uuid),
    unique index (submission_id, juror_id),
    index sync (tnid, uuid, last_updated)
) ENGINE='InnoDB', COMMENT='v1.01';
