#
# Description
# -----------
# This table stores the submissions, one for each customer_id
#
# Fields
# ------
# id:                       The ID assigned to the record.
# uuid:                     The Universal Unique ID.
# tnid:                     The Tenant ID the record belongs to.
#
# form_id:                  The ID of the form the submission is for.
#
# object:                   The object the form submission is tied to. This allows the same form
#                           to be used as a followup survey for ciniki.courses.
# object_id:                The ID of the object.
#
# customer_id:              The ID of the customer/member providing the submission, 
#                           or zero if not attached to a customer account.
#
# invoice_id:               The ID of the invoice where the submission was paid.
#
# status:                   The current status of the submission.
#
#                               10 - Opened
#                               70 - Pending payment
#                               80 - Paid
#                               90 - Submitted (and paid if fee_amount > 0 for form)
#                               100 - Accepted
#                               110 - Declined
#
# label:                    The label for the submission (created by the fields flagged 0x04)
#
# dt_terms_accepted:        The UTC date and time the terms of use were accepted.
#
# dt_last_save:             The UTC date and time the user last saved the submission.
#
# dt_last_submitted:        The UTC date and time the user last submitted or saved the form.
#
# date_added:               The UTC date and time the record was added.
# last_updated:             The UTC date and time the record was last update.
#
create table ciniki_form_submissions (
    id int not null auto_increment,
    uuid char(36) not null,
    tnid int not null,

    form_id int not null,
    object varchar(250) not null,
    object_id varchar(250) not null,
    customer_id int not null,
    invoice_id int not null,
    status tinyint unsigned not null,
    label varchar(250) not null,
    dt_terms_accepted datetime not null,
    dt_last_save datetime not null,
    dt_last_submitted datetime not null,

    date_added datetime not null,
    last_updated datetime not null,
    primary key (id),
    unique index (uuid),
    index (form_id, object, object_id, customer_id),
    index sync (tnid, uuid, last_updated)
) ENGINE='InnoDB', COMMENT='v1.01';
