#
# Description
# -----------
# This table stores the forms for a tenant.
#
# Fields
# ------
# id:                       The ID assigned to the record.
# uuid:                     The Universal Unique ID.
# tnid:                     The Tenant ID the record belongs to.
#
# name:                     The name of the form.
# permalink:                The permalink of the form, which must be unique among Active forms.
#
# type:                     Used initially for internal organization.
#
# status:                   The current status of the form.
#
#                               10 - Draft
#                               50 - Active
#                               90 - Archived
#
# flags:                    The options for the form.
#
#                               0x01 - Account Required (must create account in ciniki_customers to fill out form)
#                               0x02 - Display Simple Form, remove sections when displaying form.
#                               0x04 -
#                               0x08 - Email submission PDF with terms after submission
#                               0x10 - Juried
#                               0x20 - Jurying Enabled (jurors can login and submit votes)
#                               0x40 - 
#                               0x80 - Submit Only - no editing of submissions, used for voting/polls/silent auctions.
#                               0x0100 - Auto update customer details (must have 0x01 flag set)
#                               0x0200 - 
#                               0x0400 -
#                               0x0800 - 
# 
# max_submissions:          The maximum number of submissions allowed, or 0 for unlimited.
# max_customer_submissions: The maximum number of submissions allowed per customer.
#
# notify_emails:            The email addresses to notify upon submission.
#
# fee_label:                The label for the fee.
# fee_amount:               The submission fee to be charged.
# cartsubmit_label:         The label to use for the submit to cart.
# submit_label:             The label for the submit section and button
#
# dt_start:                 The UTC start date and time to be available.
# dt_end:                   The UTC end date to no longer accept submissions.
#
# guidelines:               The submission guidelines for the form. Will be displayed on website.
# termsofuse:               The terms of use for the form. Submitters have to agree to them.
# thankyou:                 The thank you message displayed after the form is submitted.
# emailthankyou:            The thank you message emailed with the form submission PDF.
# alreadysubmitted:         The message to display if the user has already submitted this form.
# loginmsg:                 The message to when the form requires a login.
#
# date_added:               The UTC date and time the record was added.
# last_updated:             The UTC date and time the record was last update.
#
create table ciniki_forms (
    id int not null auto_increment,
    uuid char(36) not null,
    tnid int not null,

    name varchar(250) not null,
    permalink varchar(250) not null,
    type varchar(250) not null,
    status tinyint unsigned not null,
    flags smallint unsigned not null,
    max_submissions int not null,
    max_customer_submissions int not null,
    notify_emails varchar(1000) not null,
    fee_label varchar(150) not null,
    fee_amount decimal(19,6) not null,
    cartsubmit_label varchar(150) not null,
    submit_label varchar(150) not null,
    dt_start datetime not null,
    dt_end datetime not null,
    guidelines text not null,
    termsofuse text not null,
    thankyou text not null,
    emailthankyou text not null,
    alreadysubmitted text not null,
    loginmsg text not null,

    date_added datetime not null,
    last_updated datetime not null,
    primary key (id),
    unique index (uuid),
    index sync (tnid, uuid, last_updated)
) ENGINE='InnoDB', COMMENT='v1.03';
